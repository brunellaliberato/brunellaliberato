<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Roda o ciclo do publicador do @portrasdolance a cada 15 minutos.
     Instalar:  npm run agendador:ligar     Desligar:  npm run agendador:desligar -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.portrasdolance.publicador</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/brunellaliberato/repos/brunellaliberato/perfil-futebol/publicador/publicar.mjs</string>
    <string>ciclo</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/brunellaliberato/repos/brunellaliberato/perfil-futebol</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/brunellaliberato/repos/brunellaliberato/perfil-futebol/publicador/ciclo.log</string>
  <key>StandardErrorPath</key><string>/Users/brunellaliberato/repos/brunellaliberato/perfil-futebol/publicador/ciclo.log</string>
</dict>
</plist>
